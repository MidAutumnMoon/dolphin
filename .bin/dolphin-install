#!/bin/sh
set -e
PREFIX="${DOLPHIN_DEV_PREFIX:-$PWD/install}"
cmake --install build

ICONS="$PREFIX/share/icons"
THEMES="$PREFIX/share/themes"

# --- Symlink breeze and breeze-dark icon themes ---
mkdir -p "$ICONS"
ln -sfT "@breezeIcons@/share/icons/breeze" "$ICONS/breeze" 2>/dev/null || true
ln -sfT "@breezeIcons@/share/icons/breeze-dark" "$ICONS/breeze-dark" 2>/dev/null || true

# --- Symlink breeze widget theme ---
mkdir -p "$THEMES"
ln -sfT "@breeze@/share/themes/breeze" "$THEMES/breeze" 2>/dev/null || true

# --- Fix hicolor: cmake creates a partial hicolor/ without index.theme ---
# Copy the system hicolor index.theme and missing size subdirs into our local hicolor
HICOLOR_SYS="@hicolorIconTheme@/share/icons/hicolor"
HICOLOR_LOCAL="$ICONS/hicolor"

if [ -d "$HICOLOR_SYS" ]; then
  # Copy index.theme if missing
  if [ ! -f "$HICOLOR_LOCAL/index.theme" ]; then
    cp "$HICOLOR_SYS/index.theme" "$HICOLOR_LOCAL/index.theme"
  fi
  # Symlink any size subdirs from system that we don't have locally
  # (so the icon theme is complete, not just scalable/)
  for dir in "$HICOLOR_SYS"/*/; do
    name=$(basename "$dir")
    if [ ! -e "$HICOLOR_LOCAL/$name" ]; then
      ln -sfT "$dir" "$HICOLOR_LOCAL/$name" 2>/dev/null || true
    fi
  done
fi

# --- Update icon caches ---
if [ -d "$ICONS/hicolor" ]; then
  gtk-update-icon-cache -f "$ICONS/hicolor" 2>/dev/null || true
fi
if [ -d "$ICONS/breeze" ]; then
  gtk-update-icon-cache -f "$ICONS/breeze" 2>/dev/null || true
fi

# --- Rebuild KDE service database ---
if command -v kbuildsycoca6 >/dev/null 2>&1; then
  KDE_FULL_SESSION=true kbuildsycoca6 2>/dev/null || true
fi
