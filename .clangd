# yaml-language-server: $schema=https://json.schemastore.org/clangd.json
CompileFlags:
  Add:
    - -std=c++20
    - -Wno-unknown-warning-option
    # ── pedantic baseline ──
    - -Wall
    - -Wextra
    - -Wpedantic
    # ── safety / correctness ──
    - -Wnon-virtual-dtor
    - -Woverloaded-virtual
    - -Wshadow
    - -Wnull-dereference
    - -Wformat=2
    - -Wmisleading-indentation
    # ── style / hygiene ──
    - -Wold-style-cast
    - -Wdouble-promotion
    - -Wundef

Diagnostics:
  Suppress:
    - pp_file_not_found # Qt/KDE generated headers not on disk
    - drv_unknown_argument # GCC-only flags passed to Clang
